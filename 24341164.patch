+int do_rand(unsigned long *ctx) {
+    long hi, lo, x;
+
+    x = (*ctx % 0x7ffffffe) + 1;
+    hi = x / 127773;
+    lo = x % 127773;
+    x = 16807 * lo - 2836 * hi;
